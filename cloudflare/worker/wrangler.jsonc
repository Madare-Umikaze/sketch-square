{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "processing-play-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "run_worker_first": ["/works/*"]
  },
  "r2_buckets": [
    {
      "binding": "WORKS_BUCKET",
      "bucket_name": "processing-works-dev"
    }
  ],
  "observability": {
    "enabled": true
  }
}
